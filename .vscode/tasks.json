
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "前端: 安装依赖",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "install"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "前端: 启动开发服务器",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "dev"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": [
                    {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Local:.*$",
                    "endsPattern": "^.*ready in.*$"
                }
            }
        },
        {
            "label": "前端: 构建生产版本",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "build"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "前端: 预览生产版本",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "preview"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "isBackground": true
        },
        {
            "label": "前端: 代码检查",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "lint"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "前端: 运行测试",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "test"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}